FROM docker:29.9.2-cli@sha256:5e6baf67325a79f64ed3bed6863954d5e05d0f3d4e57cbdb14809346814bbfdb
RUN apk add --no-cache python3 py3-pip openssl bash \
  && pip3 install --break-system-packages certbot
COPY scripts/cert-renewer.sh /usr/local/bin/cert-renewer.sh
RUN chmod +x /usr/local/bin/cert-renewer.sh
ENTRYPOINT ["/usr/local/bin/cert-renewer.sh"]
